  },
  {
   "depends_on": "eval:doc.secret_type === 'Credit Card'",
   "fieldname": "card_expiry",
   "fieldtype": "Data",
   "label": "Expiry (MM/YY)"
  },
  {
   "depends_on": "eval:doc.secret_type === 'Credit Card'",
   "fieldname": "card_cvv",
   "fieldtype": "Password",
   "label": "CVV"
  },
  {
   "depends_on": "eval:doc.secret_type === 'Database'",
   "fieldname": "database_section",
   "fieldtype": "Section Break",
   "label": "Database"
  },
  {
   "depends_on": "eval:doc.secret_type === 'Database'",
   "description": "Which engine this credential belongs to. Required to apply a rotated password to the live server.",
   "fieldname": "database_type",
   "fieldtype": "Select",
   "label": "Database Type",
   "mandatory_depends_on": "eval:doc.secret_type === 'Database'",
   "options": "\nPostgreSQL\nMySQL / MariaDB\nMongoDB"
  },
  {
   "depends_on": "eval:doc.secret_type === 'Database'",
   "fieldname": "db_host",
   "fieldtype": "Data",
   "label": "Host"
  },
  {
   "depends_on": "eval:doc.secret_type === 'Database'",
   "fieldname": "db_port",
   "fieldtype": "Int",
   "label": "Port",
   "description": "Leave blank to use the default port for the selected database type."
  },
  {
   "fieldname": "column_break_db",
   "fieldtype": "Column Break"
  },
  {
   "depends_on": "eval:doc.secret_type === 'Database'",
   "fieldname": "db_name",
   "fieldtype": "Data",
   "label": "Database Name"
  },
  {
   "default": "admin",
   "depends_on": "eval:doc.secret_type === 'Database' && doc.database_type === 'MongoDB'",
   "description": "MongoDB database holding this user's credentials. Usually 'admin'.",
   "fieldname": "db_auth_source",
   "fieldtype": "Data",
   "label": "Auth Source"
  },
  {
   "default": "0",
   "depends_on": "eval:doc.secret_type === 'Database'",
   "description": "Connect over TLS. Required by most managed/cloud database providers.",
   "fieldname": "db_use_ssl",
   "fieldtype": "Check",
   "label": "Use TLS / SSL"
  },
  {
   "depends_on": "eval:doc.secret_type === 'Database'",
   "fieldname": "db_password",
   "fieldtype": "Password",
   "label": "Database Password"
  },
  {
   "depends_on": "eval:doc.secret_type === 'Linux Server'",
   "fieldname": "linux_section",
   "fieldtype": "Section Break",
   "label": "Linux Servers"
  },
  {
   "depends_on": "eval:doc.secret_type === 'Linux Server'",
   "description": "Every machine this account exists on. One row rotates a single VM; many rows rotate them together, and the password is only stored once every host has accepted it.",
   "fieldname": "linux_hosts",
   "fieldtype": "Table",
   "label": "Hosts",
   "options": "Vault Linux Host"
  },
  {
   "default": "22",
   "depends_on": "eval:doc.secret_type === 'Linux Server'",
   "description": "Default SSH port, used for any host row that does not set its own.",
   "fieldname": "ssh_port",
   "fieldtype": "Int",
   "label": "Default SSH Port"
  },
  {
   "depends_on": "eval:doc.secret_type === 'Linux Server'",
   "fieldname": "ansible_section",
   "fieldtype": "Section Break",
   "label": "Automation Access"
  },
  {
   "depends_on": "eval:doc.secret_type === 'Linux Server'",
   "description": "The account Vault connects as over SSH. Must not be the account being rotated — changing its password would lock Vault out of these hosts.",
   "fieldname": "ansible_user",
   "fieldtype": "Data",
   "label": "Ansible User",
   "mandatory_depends_on": "eval:doc.secret_type === 'Linux Server'"
  },
  {
   "depends_on": "eval:doc.secret_type === 'Linux Server'",
   "description": "Private key for the Ansible user. Vault only connects to Linux hosts by key — never a password — so there is no SSH credential for this account sitting in the vault. Written to a private file only for the duration of a run, and never rotated by Vault.",
   "fieldname": "ansible_ssh_private_key",
   "fieldtype": "Password",
   "label": "SSH Private Key",
   "mandatory_depends_on": "eval:doc.secret_type === 'Linux Server'"
  },
  {
   "fieldname": "column_break_ansible",
   "fieldtype": "Column Break"
  },
  {
   "default": "1",
   "depends_on": "eval:doc.secret_type === 'Linux Server'",
   "description": "Escalate to root with sudo. Required unless the Ansible user is already root.",
   "fieldname": "ansible_use_become",
   "fieldtype": "Check",
   "label": "Use sudo (become)"
  },
  {
   "depends_on": "eval:doc.secret_type === 'Linux Server' && doc.ansible_use_become",
   "description": "Only needed where sudo prompts for a password. Leave blank for passwordless sudo.",
   "fieldname": "ansible_become_password",
   "fieldtype": "Password",
   "label": "sudo Password"
  },
  {
   "default": "1",
   "depends_on": "eval:doc.secret_type === 'Linux Server'",
   "description": "Verify each host's SSH key against known_hosts. Turning this off lets Vault push this password to a machine impersonating your server — only do so on a trusted network.",
   "fieldname": "strict_host_key_checking",
   "fieldtype": "Check",
   "label": "Strict Host Key Checking"
  },
  {
   "fieldname": "additional_section",
   "fieldtype": "Section Break",
   "label": "Additional Information"
  },
  {
   "fieldname": "notes",
   "fieldtype": "Text Editor",
   "label": "Notes"
  },
  {
   "fieldname": "custom_fields_json",
   "fieldtype": "JSON",
   "hidden": 1,
   "label": "Custom Fields"
  },
  {
   "fieldname": "expiry_section",
   "fieldtype": "Section Break",
   "label": "Expiry"
  },
  {
   "fieldname": "expires_on",
   "fieldtype": "Date",
   "label": "Expires On"
  },
  {
   "depends_on": "eval:['Password', 'Database', 'Linux Server'].includes(doc.secret_type)",
   "fieldname": "rotation_section",
   "fieldtype": "Section Break",
   "label": "Rotation"
  },
  {
   "default": "0",
   "description": "Generate a new password on a schedule. Everyone with access is notified and can read the new value here. For Database secrets you can additionally have it applied to the live server; otherwise this updates the stored value only and you must apply it yourself. Emailing the new password as an encrypted archive is optional — see Vault Settings.",
   "fieldname": "enable_rotation",
   "fieldtype": "Check",
   "label": "Enable Automatic Rotation"
  },
  {
   "default": "90",
   "depends_on": "eval:doc.enable_rotation",
   "fieldname": "rotation_interval",
   "fieldtype": "Int",
   "label": "Rotate Every",
   "mandatory_depends_on": "eval:doc.enable_rotation"
  },
  {
   "default": "Days",
   "depends_on": "eval:doc.enable_rotation",
   "fieldname": "rotation_unit",
   "fieldtype": "Select",
   "label": "Interval Unit",
   "mandatory_depends_on": "eval:doc.enable_rotation",
   "options": "Days\nHours"
  },
  {
   "fieldname": "column_break_rotation2",
   "fieldtype": "Column Break"
  },
  {
   "depends_on": "eval:doc.enable_rotation",
   "description": "Protects this secret's rotation archive with a passphrase of your own instead of the shared site one. Stored encrypted, the same way as this secret's own password — recoverable by anyone with Administrator or direct server access, same as any other stored value here. Used automatically by the hourly rotation job to build this secret's archive. Leave blank to use the shared site passphrase.",
   "fieldname": "zip_passphrase",
   "fieldtype": "Password",
   "label": "Custom Rotation Passphrase"
  },
  {
   "default": "0",
   "depends_on": "eval:doc.enable_rotation",
   "fieldname": "has_zip_passphrase",
   "fieldtype": "Check",
   "label": "Passphrase Protection Active",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.secret_type === 'Database' && doc.enable_rotation",
   "fieldname": "target_apply_section",
   "fieldtype": "Section Break",
   "label": "Apply to Live Database"
  },
  {
   "default": "0",
   "depends_on": "eval:doc.secret_type === 'Database' && doc.enable_rotation",
   "description": "Connect to the database on every rotation and change the password there too, so the vault and the server stay in sync. The rotation is aborted and the stored value left untouched if the server cannot be updated.",
   "fieldname": "apply_rotation_to_target",
   "fieldtype": "Check",
   "label": "Apply New Password to the Database"
  },
  {
   "depends_on": "eval:doc.apply_rotation_to_target",
   "description": "The privileged account Vault authenticates as to reset the password above. Required — relying on the account to change its own password fails on servers that withhold that privilege, and it fails unattended.",
   "fieldname": "rotation_admin_username",
   "fieldtype": "Data",
   "label": "Rotation Admin Username",
   "mandatory_depends_on": "eval:doc.apply_rotation_to_target"
  },
  {
   "fieldname": "column_break_target",
   "fieldtype": "Column Break"
  },
  {
   "depends_on": "eval:doc.apply_rotation_to_target",
   "description": "Stored encrypted, the same way as this secret's own password. Never rotated by this app.",
   "fieldname": "rotation_admin_password",
   "fieldtype": "Password",
   "label": "Rotation Admin Password",
   "mandatory_depends_on": "eval:doc.apply_rotation_to_target"
  },
  {
   "depends_on": "eval:doc.apply_rotation_to_target",
   "fieldname": "last_target_apply_status",
   "fieldtype": "Select",
   "label": "Last Applied to Database",
   "options": "\nSuccess\nFailed",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.apply_rotation_to_target",
   "fieldname": "last_target_apply_on",
   "fieldtype": "Datetime",
   "label": "Last Applied On",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.last_target_apply_status === 'Failed'",
   "fieldname": "last_target_apply_error",
   "fieldtype": "Small Text",
   "label": "Last Apply Error",
   "read_only": 1
  },
  {
   "collapsible": 1,
   "fieldname": "password_history_section",
   "fieldtype": "Section Break",
   "label": "Password History"
  },
  {
   "description": "One-way hashes of previous passwords. Used to enforce the reuse policy — past values cannot be recovered.",
   "fieldname": "password_history",
   "fieldtype": "Table",
   "label": "Password History",
   "options": "Vault Password History",
   "read_only": 1
  },
  {
   "collapsible": 1,
   "fieldname": "metadata_section",
   "fieldtype": "Section Break",
   "label": "Metadata"
  },
  {
   "fieldname": "password_strength",
   "fieldtype": "Select",
   "label": "Password Strength",
   "options": "\nweak\nfair\ngood\nstrong\nexcellent",
   "read_only": 1
  },
  {
   "fieldname": "password_last_changed",
   "fieldtype": "Date",
   "in_list_view": 1,
   "label": "Password Last Changed",
   "read_only": 1
  },
  {
   "fieldname": "last_rotated_on",
   "fieldtype": "Datetime",
   "label": "Last Rotated On",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.enable_rotation",
   "fieldname": "next_rotation_on",
   "fieldtype": "Datetime",
   "label": "Next Rotation On",
   "read_only": 1
  },
  {
   "fieldname": "column_break_meta",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "last_accessed",
   "fieldtype": "Datetime",
   "label": "Last Accessed",
   "read_only": 1
  },
  {
   "default": "0",
   "fieldname": "access_count",
   "fieldtype": "Int",
   "label": "Access Count",
